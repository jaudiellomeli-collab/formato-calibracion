# Plantilla de secretos del formato de calibracion.
#
# En el servidor se copia a .streamlit/secrets.toml (ignorado por git) y se
# llena con los valores reales:
#
#     mkdir -p .streamlit
#     cp secrets.toml.example .streamlit/secrets.toml
#     chmod 600 .streamlit/secrets.toml
#
# El refresh_token sale de correr una vez en tu computadora:
#
#     python obtener_token_google.py client_secret.json
#
# Sin este archivo la app abre, pero no guarda borradores, no sube a Drive ni
# manda el correo.

# ID de la carpeta raiz de Drive (lo que va despues de /folders/ en la URL).
drive_carpeta_id = ""

# A quien le llega el correo con cada formato.
correo_coordinador = ""

# Opcional: clave para que la coordinacion edite la base del asistente.
# clave_coordinacion = ""

[google_oauth]
client_id = ""
client_secret = ""
refresh_token = ""
