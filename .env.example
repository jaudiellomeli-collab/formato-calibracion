# Plantilla de .env del formato de calibracion.
#
# En el servidor se copia a .env (ignorado por git) y se llena:
#
#     cp .env.example .env
#     chmod 600 .env
#
# La app lee primero estas variables y, si alguna esta vacia o no existe,
# usa .streamlit/secrets.toml. Se puede usar cualquiera de los dos.
#
# El refresh_token sale de correr una vez en tu computadora:
#
#     python obtener_token_google.py client_secret.json

# --- Docker y nginx (los llena scripts/servidor-ubuntu.sh) ---
# FORMATO_PUBLICAR=127.0.0.1:8084
# RUTA_BASE=formato-calibracion

# --- Secretos de la app ---
# ID de la carpeta raiz de Drive (lo que va despues de /folders/ en la URL).
DRIVE_CARPETA_ID=

# A quien le llega el correo con cada formato.
CORREO_COORDINADOR=

# Clave del panel de coordinacion (historial y entrenamiento del asistente).
CLAVE_COORDINACION=

# Cuenta de Google (OAuth) para Drive y Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
